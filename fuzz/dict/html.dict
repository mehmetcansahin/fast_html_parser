# libFuzzer dictionary for the HTML tokenizer and tree targets.
# Covers every tokenizer mode switch, terminator, and EOF-sensitive prefix.

# Markup openers and terminators
"<"
">"
"</"
"/>"
"</>"
"<!"
"<?"
"<!--"
"-->"
"--!>"
"<!---->"
"<!-->"
"<!--->"
"<![CDATA["
"]]>"
"<!DOCTYPE"
"<!doctype html>"
"</ "

# Attributes
"="
"=\""
"='"
"\""
"'"
" checked"
" class=\"a\""
" id=x"
" href='x>y'"

# Raw text, RCDATA, and plaintext elements
"<script>"
"</script>"
"</SCRIPT "
"<!--<script>"
"<!--<script"
"<style>"
"</style>"
"<title>"
"</title>"
"<textarea>"
"</textarea "
"<xmp>"
"</xmp>"
"<iframe>"
"</iframe>"
"<noembed>"
"</noembed>"
"<noframes>"
"</noframes>"
"<plaintext>"

# Ordinary and void elements
"<div>"
"</div>"
"<p>"
"<a "
"<br/>"
"<img "
"<input "

# Character references
"&"
"&amp;"
"&amp"
"&lt"
"&notin;"
"&notit;"
"&#"
"&#x"
"&#65;"
"&#x41;"
"&#x110000;"
"&#0;"
"&CounterClockwiseContourIntegral;"

# Whitespace, NUL, and multi-byte UTF-8
" "
"\x09"
"\x0a"
"\x0c"
"\x0d"
"\x00"
"\xc3\xa9"
"\xe6\x97\xa5"
"\xf0\x9f\x99\x82"
